# Vite only exposes variables prefixed with VITE_
# Server origin only — no trailing /api
VITE_API_URL=http://localhost:5001

# Supabase Storage (browser-safe publishable/anon key only — never a service-role or secret key)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
# Storage bucket used for public blog / our-works images
VITE_SUPABASE_STORAGE_BUCKET=user-images
